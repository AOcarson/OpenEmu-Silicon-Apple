+
+        -- headless interface
+		MAME_DIR .. "src/osd/headless/public/osd.h",
+	}
+
+
+
+project ("ocore_" .. _OPTIONS["osd"])
+	targetsubdir(_OPTIONS["target"] .."_" .. _OPTIONS["subtarget"])
+	uuid (os.uuid("ocore_" .. _OPTIONS["osd"]))
