+
+@protocol OSDDelegate <NSObject>
+- (void)didInitialize;
+- (void)didChangeDisplayBounds:(NSSize)bounds fps:(double)fps aspect:(NSSize)aspect;
+- (void)updateAudioBuffer:(int16_t const *)buffer samples:(NSInteger)samples;
