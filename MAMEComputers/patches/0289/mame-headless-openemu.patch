+#import "driver+private.h"
+#import "DriverList+Private.h"
+#import <emu.h>
+#import "../../frontend/mame/infoxml.h"
+
+// GameDriverOptions keeps the bit layout of MAME 0.250's machine flags so
+// frontends built against it keep working. Newer MAME keeps the same facts in
+// machine_flags (driver->flags) and in the driver's device type (emulation
+// flags, unemulated and imperfect features); -flags translates them. The
+// machine type (arcade/console/computer) is no longer recorded by MAME.
+static GameDriverOptions OEDriverOptions(game_driver const &driver)
+{
+	GameDriverOptions options = 0;
+	auto const mflags = driver.flags;
+	if (mflags & machine_flags::NO_COCKTAIL)      options |= GameDriverMachineNoCocktail;
+	if (mflags & machine_flags::IS_BIOS_ROOT)     options |= GameDriverMachineIsBiosRoot;
+	if (mflags & machine_flags::REQUIRES_ARTWORK) options |= GameDriverMachineRequiresArtwork;
+	if (mflags & machine_flags::UNOFFICIAL)       options |= GameDriverMachineUnofficial;
+	if (mflags & machine_flags::NO_SOUND_HW)      options |= GameDriverMachineNoSoundHw;
+	if (mflags & machine_flags::MECHANICAL)       options |= GameDriverMachineMechanical;
+	if (mflags & machine_flags::IS_INCOMPLETE)    options |= GameDriverMachineIsIncomplete;
+
+	auto const eflags = driver.type.emulation_flags();
+	if (eflags & emu::detail::device_flags::NOT_WORKING)           options |= GameDriverMachineNotWorking;
+	if (!(eflags & emu::detail::device_flags::SAVE_UNSUPPORTED))   options |= GameDriverMachineSupportsSave;
+
+	auto const unemulated = driver.type.unemulated_features();
+	auto const imperfect = driver.type.imperfect_features();
+	if ((unemulated | imperfect) & emu::detail::device_feature::PROTECTION) options |= GameDriverMachineUnemulatedProtection;
+	if (unemulated & emu::detail::device_feature::PALETTE)    options |= GameDriverMachineWrongColors;
+	if (imperfect & emu::detail::device_feature::PALETTE)     options |= GameDriverMachineImperfectColors;
+	if ((unemulated | imperfect) & emu::detail::device_feature::GRAPHICS) options |= GameDriverMachineImperfectGraphics;
+	if (unemulated & emu::detail::device_feature::SOUND)      options |= GameDriverMachineNoSound;
+	if (imperfect & emu::detail::device_feature::SOUND)       options |= GameDriverMachineImperfectSound;
+	if ((unemulated | imperfect) & emu::detail::device_feature::CONTROLS) options |= GameDriverMachineImperfectControls;
+	if (unemulated & emu::detail::device_feature::MICROPHONE) options |= GameDriverMachineNoDeviceMicrophone;
+	if (unemulated & emu::detail::device_feature::PRINTER)    options |= GameDriverMachineNoDevicePrinter;
+	if (unemulated & emu::detail::device_feature::LAN)        options |= GameDriverMachineNoDeviceLan;
+	if ((unemulated | imperfect) & emu::detail::device_feature::TIMING) options |= GameDriverMachineImperfectTiming;
+	return options;
+}
+
+@implementation GameDriver {
+	game_driver const *_driver;
+	NSString *_name;
+	NSString *_shortName;
+	NSString *_fullName;
+	NSString *_parent;
+}
+
+- (instancetype)initWithGameDriver:(game_driver const *)driver
+{
+	if ((self = [super init]))
+	{
+		_driver = driver;
+	}
+	return self;
+}
+
+- (NSString *)name
+{
+	return _name ?: (_name = NSSTRING_NO_COPY(_driver->name));
+}
+
+- (NSString *)shortName
+{
+	return _shortName ?: (_shortName = NSSTRING_NO_COPY(_driver->type.shortname()));
+}
+
+- (NSString *)fullName
+{
+	return _fullName ?: (_fullName = NSSTRING_NO_COPY(_driver->type.fullname()));
+}
+
