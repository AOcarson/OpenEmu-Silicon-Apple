+	// otherwise, perform validity checks before anything else
+	_isEmpty = (_gameDriver == &GAME_NAME(___empty));
+	if (!_isEmpty)
+	{
+		validity_checker valid(*_options.options, true);
+		valid.set_verbose(false);
+		valid.check_shared_source(*_gameDriver);
+	}
