+// The one screen the current view shows, or nullptr if it shows several.
+screen_device *headless_osd_interface::view_screen() const
+{
+	screen_device *found = nullptr;
+	for (screen_device &screen : screen_device_enumerator(m_machine->root_device()))
+	{
+		if (m_target->current_view().has_visible_screen(screen))
+		{
+			if (found)
+				return nullptr;
+			found = &screen;
+		}
+	}
+	return found;
+}
+
+bool headless_osd_interface::show_screen(const char *tag)
+{
+	if (m_machine == nullptr || m_target == nullptr)
+		return false;
+	screen_device *screen = m_machine->root_device().subdevice<screen_device>(tag);
+	if (screen == nullptr)
+		return false;
+
+	unsigned const original = m_target->view();
+	for (unsigned i = 0; m_target->view_name(i) != nullptr; i++)
+	{
+		m_target->set_view(i);
+		layout_view &view = m_target->current_view();
+		if (view.visible_screen_count() == 1 && view.has_visible_screen(*screen))
+		{
+			update_dimensions();
+			return true;
+		}
+	}
+	m_target->set_view(original);
+	return false;
+}
