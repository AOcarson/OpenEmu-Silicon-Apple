+		try
+		{
+			_options->set_value(optname, std::string_view(value.UTF8String), OPTION_PRIORITY_CMDLINE);
+		}
+		catch (options_exception &ex)
+		{
+			failure = [NSString stringWithFormat:@"MAME rejected %@ = \"%@\": %s", name, value, ex.message().c_str()];
+		}
+		catch (std::exception &ex)
+		{
+			failure = [NSString stringWithFormat:@"MAME rejected %@ = \"%@\": %s", name, value, ex.what()];
+		}
+	}
+
+	if (failure != nil)
+	{
+		os_log_error(OE_LOG, "%{public}@", failure);
+		if (error)
+		{
+			*error = [NSError errorWithDomain:MAMEErrorDomain code:MAMEErrorInvalidOption
+			                         userInfo:@{NSLocalizedDescriptionKey: failure}];
+		}
+		return NO;
+	}
+
+	return YES;
+}
+
+- (NSString *)valueForOptionNamed:(NSString *)name
+{
+	std::string const optname(name.UTF8String);
+	if (!_options->exists(optname))
+	{
+		return nil;
+	}
+	char const *value = _options->value(optname);
+	return value ? @(value) : @"";
+}
