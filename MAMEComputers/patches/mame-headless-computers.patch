+//-------------------------------------------------
+//  hide_menu - close any open menus and return
+//  to the in-game handler (used by host
+//  frontends of the headless build)
+//-------------------------------------------------
+
+void mame_ui_manager::hide_menu()
+{
+	if (!is_menu_active())
+		return;
+	ui::menu::stack_reset(*this);
+	set_handler(ui_callback_type::GENERAL, handler_callback_func(&mame_ui_manager::handler_ingame, this));
+}
+
+
+//-------------------------------------------------
+//  menu hooks for the headless OSD, which can't
+//  include this header
+//-------------------------------------------------
+
+bool headless_ui_menu_active(running_machine &machine)
+{
+	return static_cast<mame_ui_manager &>(machine.ui()).is_menu_active();
+}
+
+void headless_ui_show_menu(running_machine &machine)
+{
+	static_cast<mame_ui_manager &>(machine.ui()).show_menu();
+}
+
+void headless_ui_hide_menu(running_machine &machine)
+{
+	static_cast<mame_ui_manager &>(machine.ui()).hide_menu();
+}
