+- (void)setConfigPort:(NSString *)tag mask:(uint32_t)mask value:(uint32_t)value
+{
+	@synchronized (self) {
+		if (!_configOverrides) _configOverrides = [NSMutableDictionary new];
+		NSMutableArray<NSNumber *> *pairs = [_configOverrides[tag] mutableCopy] ?: [NSMutableArray new];
+		BOOL replaced = NO;
+		for (NSUInteger i = 0; i + 1 < pairs.count; i += 2) {
+			if (pairs[i].unsignedIntValue == mask) {
+				pairs[i + 1] = @(value);
+				replaced = YES;
+			}
+		}
+		if (!replaced) {
+			[pairs addObject:@(mask)];
+			[pairs addObject:@(value)];
+		}
+		_configOverrides[tag] = pairs;
+		_configDirty = YES;
+	}
+}
+
+- (void)removeConfigPort:(NSString *)tag mask:(uint32_t)mask
+{
+	@synchronized (self) {
+		NSMutableArray<NSNumber *> *pairs = [_configOverrides[tag] mutableCopy];
+		for (NSUInteger i = 0; i + 1 < pairs.count; i += 2) {
+			if (pairs[i].unsignedIntValue == mask) {
+				[pairs removeObjectsInRange:NSMakeRange(i, 2)];
+				break;
+			}
+		}
+		if (pairs) _configOverrides[tag] = pairs;
+	}
+}
+
+- (void)_applyConfigOverrides
+{
+	NSDictionary<NSString *, NSArray<NSNumber *> *> *overrides;
+	@synchronized (self) {
+		if (!_configDirty || !_machine) return;
+		_configDirty = NO;
+		overrides = [_configOverrides copy];
+	}
+
+	for (NSString *tag in overrides) {
+		auto const found = _machine->ioport().ports().find(std::string(tag.UTF8String));
+		if (found == _machine->ioport().ports().end()) continue;
+		ioport_port *port = found->second.get();
+		NSArray<NSNumber *> *pairs = overrides[tag];
+		for (NSUInteger i = 0; i + 1 < pairs.count; i += 2) {
+			ioport_value mask = pairs[i].unsignedIntValue;
+			ioport_value value = pairs[i + 1].unsignedIntValue;
+			for (ioport_field &field : port->fields()) {
+				if (field.mask() != mask) continue;
+				ioport_field::user_settings settings;
+				field.get_user_settings(settings);
+				settings.value = value & mask;
+				field.set_user_settings(settings);
+			}
+		}
+	}
+}
+
