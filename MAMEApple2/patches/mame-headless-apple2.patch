+/*! Starts MAME's Lua engine once per process, which also starts any plugins
+ *  enabled through the "plugins" and "plugin" options at that moment. */
+- (void)_startLuaEngine
+{
+	if (_luaStarted)
+	{
+		return;
+	}
+	_luaStarted = true;
+
+	try
+	{
+		_manager->start_luaengine();
+	}
+	catch (emu_fatalerror &ex)
+	{
+		// Typically an unknown name in the "plugin" option. Carry on without
+		// the requested plugins rather than failing to start the machine.
+		os_log_error(OE_LOG, "could not start Lua plugins: %{public}s", ex.what());
+		_options.options->set_value(OPTION_PLUGIN, "", OPTION_PRIORITY_MAXIMUM);
+		_options.options->set_value(OPTION_NO_PLUGIN, "", OPTION_PRIORITY_MAXIMUM);
+		_manager->start_luaengine();
+	}
+}
