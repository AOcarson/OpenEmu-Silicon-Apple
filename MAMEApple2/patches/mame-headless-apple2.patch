+#pragma mark - media
+
+- (device_image_interface *)_imageDeviceNamed:(NSString *)deviceName
+{
+	if (_machine == nullptr || deviceName.length == 0)
+	{
+		return nullptr;
+	}
+
+	std::string const name(deviceName.UTF8String);
+	for (device_image_interface &image : image_interface_enumerator(_machine->root_device()))
+	{
+		if (image.brief_instance_name() == name || image.instance_name() == name)
+		{
+			return &image;
+		}
+	}
+	return nullptr;
+}
+
+- (BOOL)loadMediaAtPath:(NSString *)path forDevice:(NSString *)deviceName error:(NSError **)error
+{
+	device_image_interface *image = [self _imageDeviceNamed:deviceName];
+	if (image == nullptr)
+	{
+		if (error)
+		{
+			NSString *desc = [NSString stringWithFormat:@"The running system has no media device named \"%@\".", deviceName];
+			*error = [NSError errorWithDomain:MAMEErrorDomain code:MAMEErrorMediaLoadFailed
+			                         userInfo:@{NSLocalizedDescriptionKey: desc}];
+		}
+		return NO;
+	}
+
+	image_init_result const res = image->load(std::string_view(path.fileSystemRepresentation));
+	if (res != image_init_result::PASS)
+	{
+		os_log_error(OE_LOG, "failed to load %{public}@ into %{public}@", path, deviceName);
+		if (error)
+		{
+			NSString *desc = [NSString stringWithFormat:@"MAME could not load \"%@\".", path.lastPathComponent];
+			*error = [NSError errorWithDomain:MAMEErrorDomain code:MAMEErrorMediaLoadFailed
+			                         userInfo:@{NSLocalizedDescriptionKey: desc}];
+		}
+		return NO;
+	}
+
+	return YES;
+}
+
+- (void)unloadMediaForDevice:(NSString *)deviceName
+{
+	device_image_interface *image = [self _imageDeviceNamed:deviceName];
+	if (image != nullptr && image->exists())
+	{
+		image->unload();
+	}
+}
+
+- (NSString *)mediaPathForDevice:(NSString *)deviceName
+{
+	device_image_interface *image = [self _imageDeviceNamed:deviceName];
+	if (image == nullptr || !image->exists())
+	{
+		return nil;
+	}
+	return @(image->filename());
+}
